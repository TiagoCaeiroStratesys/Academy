{
  "name": "Academy",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "private": true,
  "scripts": {
    "dev": "cds watch",
    "start": "cds-serve",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "reset": "rimraf ./sqlite.db && npm run deploy",
    "kill_port": "kill -9 $(lsof -t -i:4004)",
    "watch-front1": "cds watch --open front1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy Academy --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "watch-rooms": "cds watch --open rooms/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "cds-swagger-ui-express": "^0.10.0",
    "mbt": "^1.2.29",
    "rimraf": "^5"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "sqlite.db"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/front1",
    "app/rooms"
  ]
}
